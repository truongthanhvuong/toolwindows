<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft All In One Installer Design By VUONGTT"
        Height="550" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="28" Height="28" Background="#EA580C" CornerRadius="4" Margin="0,0,10,0">
                    <TextBlock Text="🏢" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Microsoft All In One Installer Design By VUONGTT" FontSize="18" FontWeight="ExtraBold" Foreground="#1E293B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Body Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Col -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <GroupBox Header="1. Lựa chọn phiên bản Office" FontWeight="Bold" Foreground="#1E293B" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,3,0,3">
                            <TextBlock Text="Phiên bản:" VerticalAlignment="Center" Width="85" FontSize="13.5"/>
                            <ComboBox x:Name="dlgOfficeVer" Margin="90,0,0,0" Height="28" SelectedIndex="0">
                                <ComboBoxItem Content="Office 365"/>
                                <ComboBoxItem Content="Office 2024 LTSC"/>
                                <ComboBoxItem Content="Office 2021 ProPlus"/>
                                <ComboBoxItem Content="Office 2019 ProPlus"/>
                                <ComboBoxItem Content="Office 2016 ProPlus"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,3,0,3">
                            <TextBlock Text="Phân phối:" VerticalAlignment="Center" Width="85" FontSize="13.5"/>
                            <ComboBox x:Name="dlgOfficeDist" Margin="90,0,0,0" Height="28" SelectedIndex="0">
                                <ComboBoxItem Content="Microsoft 365 Apps for Enterprise"/>
                                <ComboBoxItem Content="Office LTSC ProPlus (Perpetual)"/>
                                <ComboBoxItem Content="Current Channel"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. Cấu hình hệ thống" FontWeight="Bold" Foreground="#1E293B" Padding="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <RadioButton x:Name="dlgRad64" Content="Cấu trúc x64" IsChecked="True" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <RadioButton x:Name="dlgRad32" Content="Cấu trúc x86" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Ngôn ngữ:" VerticalAlignment="Center" Width="85" FontSize="13.5"/>
                            <ComboBox x:Name="dlgOfficeLang" Margin="90,0,0,0" Height="28" SelectedIndex="0">
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="Tiếng Việt"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="dlgBtn2010x64" Content="Office 2010 ProPlus X64" Background="#0284C7" Style="{StaticResource DlgBtn}" Height="28" FontSize="11.5"/>
                            <Button x:Name="dlgBtn2010x86" Content="Office 2010 ProPlus X86" Background="#0284C7" Style="{StaticResource DlgBtn}" Height="28" FontSize="11.5"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Right Col -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <GroupBox Header="3. Cài đặt tùy chọn" FontWeight="Bold" Foreground="#1E293B" Padding="8" Margin="0,0,0,8">
                    <WrapPanel>
                        <CheckBox x:Name="dlgChkWord" Content="Word" IsChecked="True" Width="88" Margin="3"/>
                        <CheckBox x:Name="dlgChkExcel" Content="Excel" IsChecked="True" Width="88" Margin="3"/>
                        <CheckBox x:Name="dlgChkPowerPoint" Content="PowerPoint" IsChecked="True" Width="98" Margin="3"/>
                        <CheckBox x:Name="dlgChkAccess" Content="Access" IsChecked="True" Width="88" Margin="3"/>
                        <CheckBox x:Name="dlgChkOneNote" Content="OneNote" IsChecked="True" Width="88" Margin="3"/>
                        <CheckBox x:Name="dlgChkTeams" Content="Teams" IsChecked="False" Width="88" Margin="3"/>
                        <CheckBox x:Name="dlgChkOutlook" Content="Outlook" IsChecked="True" Width="88" Margin="3"/>
                        <CheckBox x:Name="dlgChkPublisher" Content="Publisher" IsChecked="True" Width="88" Margin="3"/>
                        <CheckBox x:Name="dlgChkOneDrive" Content="OneDrive" IsChecked="False" Width="88" Margin="3"/>
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="4. Cài đặt Project - Visio" FontWeight="Bold" Foreground="#1E293B" Padding="8">
                    <WrapPanel>
                        <CheckBox x:Name="dlgChkProject" Content="Project" IsChecked="False" Width="92" Margin="3"/>
                        <CheckBox x:Name="dlgChkVisio" Content="Visio" IsChecked="False" Width="92" Margin="3"/>
                        <CheckBox x:Name="dlgChkSkype" Content="Skype" IsChecked="False" Width="92" Margin="3"/>
                    </WrapPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Progress Bar & Status -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="5" Padding="8" Margin="0,10,0,6">
            <StackPanel>
                <TextBlock x:Name="dlgTxtStatus" Text="Sẵn sàng cài đặt Office (Nhấn 'Cài đặt tự động' để bắt đầu)" FontWeight="SemiBold" FontSize="13" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <ProgressBar x:Name="dlgPrg" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#10B981"/>
            </StackPanel>
        </Border>

        <!-- Buttons Row -->
        <Grid Grid.Row="3" Margin="0,4,0,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="dlgBtnSelectAll" Content="Chọn tất cả" Background="#2563EB" Style="{StaticResource DlgBtn}" Width="95"/>
                <Button x:Name="dlgBtnUnselectAll" Content="Bỏ chọn" Background="#0D9488" Style="{StaticResource DlgBtn}" Width="85"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="dlgBtnInstallOffice" Content="Cài Office" Background="#EA580C" Style="{StaticResource DlgBtn}" Width="95"/>
                <Button x:Name="dlgBtnStore" Content="Kho Office" Background="#7C3AED" Style="{StaticResource DlgBtn}" Width="90"/>
                <Button x:Name="dlgBtnDownload" Content="Download Tự Động" Background="#0284C7" Style="{StaticResource DlgBtn}" Width="125"/>
                <Button x:Name="dlgBtnAuto" Content="Cài đặt tự động" Background="#16A34A" Style="{StaticResource DlgBtn}" Width="115"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" Background="#E2E8F0" CornerRadius="4" Padding="6" Margin="0,4,0,0">
            <Grid>
                <TextBlock Text="📞 Phone Number: 09xx.xxx.xxx" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                <TextBlock Text="Zalo: 09xx.xxx.xxx | Designed By VUONGTT" FontSize="12" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
