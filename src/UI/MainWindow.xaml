                    </StackPanel>                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL: ADMIN LOGIN ================= -->
        <Grid x:Name="modalAdminLogin" Grid.ColumnSpan="2" Background="#90000000" Visibility="Collapsed">
