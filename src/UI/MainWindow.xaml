                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- GPU Details (Multi-GPU Support: GPU 0 + GPU 1) -->
                                <Border Style="{StaticResource CardBorder}" BorderBrush="#E5D9C8">
