                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Column: RAM & DIMM Slot Details -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
