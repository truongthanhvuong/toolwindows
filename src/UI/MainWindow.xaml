<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VUONGTT Tool Pro 2026 - v20.5.908.31"
        Height="880" Width="1420"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- ================= DYNAMIC THEMES ================= -->
        <!-- Default Theme: Elegant Warm Amber / Cream (Exact match with Screenshots) -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#FAF7F2"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#F4ECE1"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E5D9C8"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#FAF7F2"/>
        <SolidColorBrush x:Key="HeaderBorderBrush" Color="#E5D9C8"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardInnerBgBrush" Color="#FCFBF9"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5D9C8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#292524"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#78716C"/>
        <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#D6C7B2"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D6C7B2"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#292524"/>
        <SolidColorBrush x:Key="LogBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LogTextBrush" Color="#44403C"/>
        <SolidColorBrush x:Key="MenuBtnHoverBg" Color="#EADBCA"/>
        <SolidColorBrush x:Key="MenuBtnActiveBg" Color="#EADBCA"/>
        <SolidColorBrush x:Key="MenuBtnText" Color="#292524"/>
        <SolidColorBrush x:Key="PillBgBrush" Color="#EADBCA"/>
        <SolidColorBrush x:Key="PillTextBrush" Color="#78350F"/>
        <SolidColorBrush x:Key="AccentGold" Color="#B45309"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#334155"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#047857"/>
        <SolidColorBrush x:Key="AccentRed" Color="#BE123C"/>

        <!-- Control Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5,8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InnerCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardInnerBgBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuBtnText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="24,0,8,0"/>
            <Setter Property="Margin" Value="4,1,4,1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuHeaderTxt" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="14,10,0,4"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="SF Pro Display, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile Header Card -->
                <Border Grid.Row="0" Margin="12,12,12,6" Padding="10" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Avatar V -->
                        <Border Width="42" Height="42" CornerRadius="8" Background="#2563EB">
                            <TextBlock Text="V" Foreground="White" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VUONGTT Tool" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#FEF3C7" CornerRadius="4" Padding="5,1,5,1" Margin="6,0,0,0">
                                    <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="v20.5.908.31 — Professional" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Theme & Language Switchers -->
                <StackPanel Grid.Row="1" Margin="12,0,12,8">
                    <!-- Themes: Mặc Định, Tối, Sáng -->
                    <UniformGrid Columns="3" Margin="0,0,0,6">
                        <Button x:Name="btnThemeDefault" Content="Mặc Định" Height="28" FontSize="11.5" FontWeight="Bold" Background="#EADBCA" Foreground="#78350F" BorderThickness="1" BorderBrush="#D6C7B2" Cursor="Hand" Margin="2,0,2,0"/>
                        <Button x:Name="btnThemeDark" Content="Tối" Height="28" FontSize="11.5" FontWeight="SemiBold" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand" Margin="2,0,2,0"/>
                        <Button x:Name="btnThemeLight" Content="Sáng" Height="28" FontSize="11.5" FontWeight="SemiBold" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand" Margin="2,0,2,0"/>
                    </UniformGrid>
                    <!-- Language: VI, EN -->
                    <UniformGrid Columns="2">
                        <Button x:Name="btnLangVI" Height="26" Background="{DynamicResource CardBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🇻🇳" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="VI" FontSize="11" FontWeight="Bold" Foreground="#BE123C"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnLangEN" Height="26" Background="{DynamicResource CardBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🇺🇸" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="EN" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Navigation Menu Scroll -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MenuPanel" Margin="0,0,0,8">
                        <!-- GROUP 1: THÔNG TIN HỆ THỐNG -->
                        <TextBlock x:Name="txtMenuHeaderGroup1" Text="▾ THÔNG TIN HỆ THỐNG" Style="{StaticResource MenuHeaderTxt}"/>
                        <Button x:Name="btnMenuSysInfo" Style="{StaticResource MenuBtn}" Tag="SysInfo" Background="{DynamicResource MenuBtnActiveBg}" Foreground="#B45309">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻" Margin="0,0,8,0"/>
                                <TextBlock Text="Xem Cấu Hình Máy Tính"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuCustomize" Style="{StaticResource MenuBtn}" Tag="Customize">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥️" Margin="0,0,8,0"/>
                                <TextBlock Text="Tùy chỉnh thông tin máy"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuUsers" Style="{StaticResource MenuBtn}" Tag="Users">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" Margin="0,0,8,0"/>
                                <TextBlock Text="Quản lý User &amp; PC"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuBenchmark" Style="{StaticResource MenuBtn}" Tag="Benchmark">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,8,0"/>
                                <TextBlock Text="Tốc Độ Ổ Đĩa (Benchmark)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuLaptopCheck" Style="{StaticResource MenuBtn}" Tag="LaptopCheck">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔬" Margin="0,0,8,0"/>
                                <TextBlock Text="Kiểm Tra Laptop &amp; Ngoại Vi"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuCpuMain" Style="{StaticResource MenuBtn}" Tag="CpuMain">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" Margin="0,0,8,0"/>
                                <TextBlock Text="Tra Cứu CPU + Main"/>
                            </StackPanel>
                        </Button>

                        <!-- GROUP 2: CÀI ĐẶT & TẢI VỀ -->
                        <TextBlock x:Name="txtMenuHeaderGroup2" Text="▾ CÀI ĐẶT &amp; TẢI VỀ" Style="{StaticResource MenuHeaderTxt}"/>
                        <Button x:Name="btnMenuOffice" Style="{StaticResource MenuBtn}" Tag="Office">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📑" Margin="0,0,8,0"/>
                                <TextBlock Text="Cài Đặt Office (Tự Động)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuSoftware" Style="{StaticResource MenuBtn}" Tag="Software">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" Margin="0,0,8,0"/>
                                <TextBlock Text="Tải ứng dụng"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuCustomApp" Style="{StaticResource MenuBtn}" Tag="CustomApp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Margin="0,0,8,0"/>
                                <TextBlock Text="Cài app tùy chỉnh"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuUninstaller" Style="{StaticResource MenuBtn}" Tag="Uninstaller">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,8,0"/>
                                <TextBlock Text="Gỡ Bỏ Phần Mềm (Clean)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuFonts" Style="{StaticResource MenuBtn}" Tag="Fonts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔤" Margin="0,0,8,0"/>
                                <TextBlock Text="Cài font tiếng Việt"/>
                            </StackPanel>
                        </Button>

                        <!-- GROUP 3: TỐI ƯU HỆ THỐNG -->
                        <TextBlock x:Name="txtMenuHeaderGroup3" Text="▾ TỐI ƯU HỆ THỐNG" Style="{StaticResource MenuHeaderTxt}"/>
                        <Button x:Name="btnMenuCleaner" Style="{StaticResource MenuBtn}" Tag="Cleaner">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,8,0"/>
                                <TextBlock Text="Tối Ưu &amp; Dọn Dẹp"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuTweaks" Style="{StaticResource MenuBtn}" Tag="Tweaks">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,8,0"/>
                                <TextBlock Text="Tinh chỉnh Windows"/>
                            </StackPanel>
                        </Button>

                        <!-- GROUP 4: DRIVER & MÁY IN -->
                        <TextBlock x:Name="txtMenuHeaderGroup4" Text="▾ DRIVER &amp; MÁY IN" Style="{StaticResource MenuHeaderTxt}"/>
                        <Button x:Name="btnMenuPrinterLAN" Style="{StaticResource MenuBtn}" Tag="PrinterLAN">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,8,0"/>
                                <TextBlock Text="Sửa Lỗi Máy In (87 Chức Năng)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuBackupDriver" Style="{StaticResource MenuBtn}" Tag="BackupDriver">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" Margin="0,0,8,0"/>
                                <TextBlock Text="Backup Driver Thiết Bị"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuDevMgmt" Style="{StaticResource MenuBtn}" Tag="DevMgmt">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛠️" Margin="0,0,8,0"/>
                                <TextBlock Text="Mở Device Manager"/>
                            </StackPanel>
                        </Button>

                        <!-- GROUP 5: TIỆN ÍCH KỸ THUẬT -->
                        <TextBlock x:Name="txtMenuHeaderGroup5" Text="▾ TIỆN ÍCH KỸ THUẬT" Style="{StaticResource MenuHeaderTxt}"/>
                        <Button x:Name="btnMenuActivation" Style="{StaticResource MenuBtn}" Tag="Activation">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" Margin="0,0,8,0"/>
                                <TextBlock Text="Kích Hoạt (MAS HWID)"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuBitLocker" Style="{StaticResource MenuBtn}" Tag="BitLocker">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒" Margin="0,0,8,0"/>
                                <TextBlock Text="Tắt BitLocker - EFS"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuAutoWin" Style="{StaticResource MenuBtn}" Tag="AutoWin">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,8,0"/>
                                <TextBlock Text="Cài Win &amp; Bypass"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnMenuPartition" Style="{StaticResource MenuBtn}" Tag="Partition">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💽" Margin="0,0,8,0"/>
                                <TextBlock Text="Quản Lý Phân Vùng (Partition Pro)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Exit App Button -->
                <Border Grid.Row="3" Padding="12,6,12,10" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
                    <Button x:Name="btnExitApp" Background="#FEE2E2" Foreground="#BE123C" Content="🚪 Thoát Ứng Dụng" FontWeight="Bold" FontSize="13" Height="32" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN WORKSPACE ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="18,0,18,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtPageIcon" Text="💻" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtPageTitle" Text="Xem Cấu Hình Máy Tính" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Right: Realtime Clock, Auto Update & Lifetime Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtRealtimeClock" Text="14:51:21 | 08/09/2026" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="btnCheckAppUpdate" Content="🔄 Cập Nhật Tool" Height="28" Background="#B45309" Foreground="White" FontWeight="Bold" FontSize="11.5" Padding="10,0,10,0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Kiểm tra và tự động cập nhật phiên bản mới nhất">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Background="#ECFDF5" CornerRadius="12" Padding="10,3,10,3" BorderBrush="#A7F3D0" BorderThickness="1">
                            <TextBlock Text="• LIFETIME" FontSize="11.5" FontWeight="Bold" Foreground="#047857"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pages Container -->
            <Grid Grid.Row="1" Margin="14">

                <!-- ================= PAGE 1: XEM CẤU HÌNH MÁY TÍNH ================= -->
                <ScrollViewer x:Name="pageSysInfo" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                    <StackPanel>
                        <!-- 6 Gauges / Meter Cards Row (Exact Match Screenshot 1) -->
                        <UniformGrid Columns="6" Margin="0,0,0,12">
                            <!-- Gauge 1: Total System Load -->
                            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="8,10,8,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="68" Height="68" CornerRadius="34" BorderBrush="#F97316" BorderThickness="4" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtGaugeTotalPercent" Text="39%" FontSize="18" FontWeight="Bold" Foreground="#F97316" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Tải hệ thống" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="Tổng quan CPU &amp; RAM" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Gauge 2: CPU -->
                            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="8,10,8,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="68" Height="68" CornerRadius="34" BorderBrush="#10B981" BorderThickness="4" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtGaugeCpuPercent" Text="67%" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtGaugeCpuSub" Text="2.90 GHz · 28°C" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="CPU" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtGaugeCpuName" Text="Intel Core i5-9400" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Gauge 3: RAM -->
                            <Border Style="{StaticResource CardBorder}" Margin="3" Padding="8,10,8,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="68" Height="68" CornerRadius="34" BorderBrush="#8B5CF6" BorderThickness="4" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtGaugeRamPercent" Text="61%" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
