                                <TextBlock Text="📄 Nhật Ký Cài Đặt Font" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtFontLog" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" TextWrapping="Wrap" IsReadOnly="True" FontSize="13" Height="130" Text="Sẵn sàng nạp bộ font tiếng Việt vào hệ thống Windows..."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= PAGE 17: SAO LƯU & KHÔI PHỤC DRIVER ================= -->
                <ScrollViewer x:Name="pageBackupDriver" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💾 SAO LƯU &amp; KHÔI PHỤC DRIVER THIẾT BỊ HỆ THỐNG" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Trích xuất toàn diện Driver phần cứng (.inf) ra thư mục sao lưu và khôi phục nhanh chóng khi cài lại Windows." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💾 CÔNG CỤ SAO LƯU DRIVER (BACKUP)" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="btnBackupAllDrivers" Content="💾 Sao Lưu Toàn Bộ Driver Hệ Thống" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="270" Padding="14,0,14,0"/>
                                    <Button x:Name="btnBackupPrinterDrivers" Content="🖨️ Sao Lưu Riêng Driver Máy In" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="240" Padding="14,0,14,0"/>
                                    <Button x:Name="btnExportDriverList" Content="📋 Xuất Danh Sách Driver (.TXT)" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="240" Padding="14,0,14,0"/>
                                    <Button x:Name="btnOpenBackupFolder" Content="📂 Mở Thư Mục C:\Backup_Drivers" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="240" Padding="14,0,14,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🔄 KHÔI PHỤC &amp; QUẢN LÝ THIẾT BỊ (RESTORE &amp; DEVICE)" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="btnRestoreDrivers" Content="🔄 Khôi Phục Driver Từ Thư Mục Backup" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="280" Padding="14,0,14,0"/>
                                    <Button x:Name="btnCheckMissingDrivers" Content="⚠️ Quét Thiết Bị Thiếu Driver (!)" Background="#BE123C" Style="{StaticResource ActionBtn}" MinWidth="250" Padding="14,0,14,0"/>
                                    <Button x:Name="btnOpenDeviceManagerDirect" Content="🛠️ Mở Device Manager (devmgmt.msc)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="270" Padding="14,0,14,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="📄 Nhật Ký Quá Trình Sao Lưu &amp; Khôi Phục Driver" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtDriverLog" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" TextWrapping="Wrap" IsReadOnly="True" FontSize="13" Height="150" Text="Sẵn sàng sao lưu hoặc nạp lại Driver cho thiết bị phần cứng..."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= PAGE 18: CÀI WIN & BYPASS ================= -->
                <ScrollViewer x:Name="pageAutoWin" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🚀 BỘ CÔNG CỤ CÀI WIN &amp; BYPASS WINDOWS 11 / 10" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="1-Click Bypass phần cứng TPM 2.0 / SecureBoot / RAM 4GB, Bypass tài khoản Microsoft (OOBE/MSA), tải ISO gốc và Rufus." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🛡️ 1-CLICK BYPASS CÀI ĐẶT WINDOWS 11" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="btnBypassWin11All" Content="⚡ 1-Click Bypass Tất Cả (TPM + RAM + CPU)" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="290" Padding="14,0,14,0"/>
                                    <Button x:Name="btnBypassOOBEMSA" Content="👤 Bypass Tài Khoản Microsoft (OOBE\BYPASSNRO)" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="310" Padding="14,0,14,0"/>
                                    <Button x:Name="btnDisableBitLockerSetup" Content="🔓 Tắt Tự Động Mã Hóa BitLocker Khi Cài Win" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="290" Padding="14,0,14,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📥 TẢI BỘ CÀI WINDOWS &amp; CÔNG CỤ TẠO USB BOOT" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="btnDownloadWin11ISO" Content="📥 Tải Windows 11 Chính Hãng (Microsoft)" Background="#047857" Style="{StaticResource ActionBtn}" MinWidth="280" Padding="14,0,14,0"/>
                                    <Button x:Name="btnDownloadWin10ISO" Content="📥 Tải Windows 10 Chính Hãng (Microsoft)" Background="#047857" Style="{StaticResource ActionBtn}" MinWidth="280" Padding="14,0,14,0"/>
                                    <Button x:Name="btnDownloadRufus" Content="💾 Tải Rufus Mới Nhất (Tạo USB Cài Win)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="270" Padding="14,0,14,0"/>
                                    <Button x:Name="btnDownloadVentoy" Content="📀 Tải Ventoy Mới Nhất (USB Multi-Boot)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="270" Padding="14,0,14,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🛠️ TỐI ƯU HÓA HỆ THỐNG SAU CÀI WIN (POST-INSTALL)" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="btnPostInstallTweak" Content="⚡ 1-Click Tối Ưu Sau Cài Win (Gỡ Bloatware &amp; Quảng Cáo)" Background="#BE123C" Style="{StaticResource ActionBtn}" MinWidth="380" Padding="14,0,14,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="📄 Nhật Ký Thực Thi Cài Win &amp; Bypass" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtAutoWinLog" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" TextWrapping="Wrap" IsReadOnly="True" FontSize="13" Height="140" Text="Sẵn sàng thực thi các công cụ hỗ trợ cài đặt Windows..."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= PAGE 19: QUẢN LÝ PHÂN VÙNG (PARTITION PRO) ================= -->
                <ScrollViewer x:Name="pagePartition" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Header Banner -->
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="4" Background="#334155" Margin="0,0,10,0">
                                            <TextBlock Text="💽" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Quản Lý Phân Vùng Ổ Đĩa (Partition Wizard Pro)" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Sơ đồ đĩa thời gian thực, tối ưu TRIM SSD, quét lỗi Bad Sector, chuyển MBR sang GPT &amp; công cụ Partition Wizard" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="40,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="10,4,10,4" VerticalAlignment="Center">
                                    <TextBlock Text="🟢 Live Storage Engine" FontWeight="Bold" Foreground="#047857" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Action Toolbar Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🛠️ THANH CÔNG CỤ QUẢN LÝ PHÂN VÙNG CHUYÊN NGHIỆP" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="btnRefreshDisks" Content="🔄 Làm Mới Danh Sách Đĩa" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="195" Padding="12,0,12,0"/>
                                    <Button x:Name="btnOpenDiskMgmt" Content="🛠️ Mở Disk Management (Windows)" Background="#047857" Style="{StaticResource ActionBtn}" MinWidth="250" Padding="12,0,12,0"/>
                                    <Button x:Name="btnOpenDiskPart" Content="💻 Mở DiskPart (Admin Console)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="220" Padding="12,0,12,0"/>
                                    <Button x:Name="btnLaunchMiniTool" Content="🚀 Mở MiniTool / DiskGenius" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="210" Padding="12,0,12,0"/>
                                    <Button x:Name="btnTrimAllSSD" Content="⚡ TRIM &amp; Dồn Đĩa Toàn Bộ" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="200" Padding="12,0,12,0"/>
                                    <Button x:Name="btnCheckMbr2Gpt" Content="🛡️ Kiểm Tra MBR sang GPT (UEFI)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="230" Padding="12,0,12,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Operations Card (Check Disk, Change Label/Drive Letter) -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🔍 KIỂM TRA LỖI BỀ MẶT &amp; TINH CHỈNH PHÂN VÙNG" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                    <TextBlock Text="Phân vùng:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="cmbPartitionDrives" Width="90" Height="32" VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                                    <Button x:Name="btnChkdskScan" Content="🔍 Quét Lỗi Bề Mặt (Chkdsk)" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="195" Padding="12,0,12,0"/>

                                    <TextBlock Text="Tên mới:" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                    <TextBox x:Name="txtNewVolumeLabel" Width="140" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" Text="Data"/>
                                    <Button x:Name="btnChangeLabel" Content="🏷️ Đổi Tên Ổ" Background="#047857" Style="{StaticResource ActionBtn}" Width="120"/>

                                    <TextBlock Text="Ký tự mới:" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                    <TextBox x:Name="txtNewDriveLetter" Width="50" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" Text="E"/>
                                    <Button x:Name="btnChangeDriveLetter" Content="🔤 Đổi Ký Tự" Background="#B45309" Style="{StaticResource ActionBtn}" Width="120"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live Visual Storage Container -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="📊 SƠ ĐỒ PHÂN VÙNG &amp; Ổ CỨNG VẬT LÝ (LIVE MAP)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Click 'Làm Mới Danh Sách Đĩa' để cập nhật" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel x:Name="panelDisksContainer">
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="6" Padding="14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="Đang tải dữ liệu ổ đĩa và phân vùng hệ thống..." Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Execution Log -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="📄 Nhật Ký Quản Lý Phân Vùng" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button x:Name="btnClearPartitionLog" Content="Xóa Log" Background="#64748B" Style="{StaticResource ActionBtn}" Height="28" Width="80" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox x:Name="txtPartitionLog" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" TextWrapping="Wrap" IsReadOnly="True" FontSize="13" Height="150" Text="Sẵn sàng thực thi các tác vụ phân vùng đĩa và kiểm tra ổ cứng."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Bottom Status Footer (Match Screenshots) -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,0" Padding="14,0,14,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="txtFooterStatus" Text="• [OK] Sẵn sàng..." FontSize="12" Foreground="#047857" VerticalAlignment="Center"/>
                    <TextBlock Text="VUONGTT Tool Pro 2026" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="v20.5.908.31" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
