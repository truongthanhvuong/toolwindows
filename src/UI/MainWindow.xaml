                                            <Button x:Name="btnPanelCompMgmt" Content="🖥️ Computer Management" Background="#334155" Style="{StaticResource ActionBtn}" Height="30"/>
                                            <Button x:Name="btnPanelControl" Content="⚙️ Control Panel" Background="#334155" Style="{StaticResource ActionBtn}" Height="30"/>
                                            <Button x:Name="btnPanelMouse" Content="🖱️ Mouse Properties" Background="#334155" Style="{StaticResource ActionBtn}" Height="30"/>
                                            <Button x:Name="btnPanelNetwork" Content="🌐 Network (ncpa.cpl)" Background="#059669" Style="{StaticResource ActionBtn}" Height="30"/>
                                            <Button x:Name="btnPanelPower" Content="⚡ Power Panel" Background="#334155" Style="{StaticResource ActionBtn}" Height="30"/>
