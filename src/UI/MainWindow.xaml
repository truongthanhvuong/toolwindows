                                                <Grid Margin="0,2,0,3">
                                                    <TextBlock Text="Vendor Hãng:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
                                                    <TextBlock x:Name="lblGpu1Vendor" Text="NVIDIA Corporation" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12.5"/>
                                                </Grid>
                                                <Grid Margin="0,2,0,3">
                                                    <TextBlock Text="VRAM:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
                                                    <TextBlock x:Name="lblGpu1Vram" Text="4.0 GB GDDR6" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12.5"/>
                                                </Grid>
                                                <Grid Margin="0,2,0,3">
