                                        <CheckBox x:Name="tog_StartBing" Style="{StaticResource ToggleSwitch}" Content="Tìm Kiếm Web Trong Start (Start Menu Bing Search)" ToolTip="Bật tắt gợi ý tìm kiếm Web Bing trong Start Menu"/>
                                        <CheckBox x:Name="tog_WindowSnap" Style="{StaticResource ToggleSwitch}" Content="Chia Cửa Sổ (Window Snapping)" ToolTip="Kéo cửa sổ vào mép để tự chia đôi hoặc góc màn hình"/>
