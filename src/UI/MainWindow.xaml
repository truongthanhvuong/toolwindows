                            </StackPanel>                        </Border>

                        <!-- Machine / Vendor -->
                        <Border Grid.Column="6" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="HÃNG &amp; SERVICE TAG" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="lblDriverDoctorMachine" Text="VMware / PC" FontSize="13" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                <TextBlock Text="Tự dò cổng chính hãng" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>                        </Border>
                    </Grid>

                    <!-- Issue List and Details -->
