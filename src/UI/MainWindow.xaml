                                                <TextBlock Text="Chưa có license key nào được tạo." Foreground="{DynamicResource TextSecondaryBrush}" Margin="10"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Khối Đổi Mật Khẩu Admin -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="🔒 ĐỔI MẬT KHẨU QUẢN TRỊ VIÊN" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="pwdAdminChangeNew" Height="32" VerticalContentAlignment="Center" Margin="0"/>
                                            <PasswordBox x:Name="pwdAdminChangeConfirm" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="0"/>
                                            <Button x:Name="btnAdminChangePassSubmit" IsDefault="True" Grid.Column="4" Content="Đổi Mật Khẩu" Height="32" Background="#334155" Style="{StaticResource ActionBtn}"/>
                                        </Grid>
                                        <TextBlock Text="Nhập mật khẩu mới vào ô thứ nhất và xác nhận lại vào ô thứ hai." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>                                </Border>
                            </StackPanel>                        </Grid>
                    </StackPanel>                </ScrollViewer>

            </Grid>

            <!-- Bottom Status Footer (Match Screenshots) -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,0" Padding="14,0,14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtFooterStatus" Text="• [OK] Sẵn sàng..." FontSize="12" Foreground="#047857" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="© 2026 VUONGTT. Bảo lưu mọi quyền." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="•" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="btnFooterMoMo" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" ToolTip="Click để sao chép số MoMo 0328808425">
