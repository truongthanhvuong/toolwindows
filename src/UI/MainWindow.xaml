                    <StackPanel>
                        <!-- Custom App Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="📦 Cài Đặt Ứng Dụng Tùy Chỉnh (Winget ID hoặc Link URL)" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
