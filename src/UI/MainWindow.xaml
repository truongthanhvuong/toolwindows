                                                <Button x:Name="btnImportKeys" Content="📥 Nhập Key" Height="26" Background="#334155" Style="{StaticResource ActionBtn}" Padding="8,0,8,0" Margin="0,0,0,2" ToolTip="Nhập danh sách mã Key từ máy khác"/>
