                                        <CheckBox x:Name="app_everything" Content="🔍 Everything Search" IsChecked="True" Width="190" Margin="4"/>
                                        <CheckBox x:Name="app_fdm" Content="⚡ Free Download Manager" Width="220" Margin="4"/>
                                        <CheckBox x:Name="app_crystaldiskmark" Content="📊 CrystalDiskMark" Width="180" Margin="4"/>
                                        <CheckBox x:Name="app_vscode" Content="💻 Visual Studio Code" Width="190" Margin="4"/>
