                                        <GridViewColumn Header="Dung Lượng" Width="90" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                        <GridViewColumn Header="Thư Mục Cài Đặt" Width="240" DisplayMemberBinding="{Binding InstallLocation}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

