                                </Grid>
                                <TextBox x:Name="txtUninstallerLog" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" TextWrapping="Wrap" IsReadOnly="True" FontSize="12.5" Height="110" Text="Chọn một phần mềm ở bảng trên rồi bấm 'Gỡ Sạch Triệt Để' hoặc 'Gỡ Cài Đặt Tiêu Chuẩn'."/>
                            </StackPanel>                        </Border>
                    </StackPanel>                </ScrollViewer>

                <!-- ================= PAGE 9: TEST LAPTOP, PHẦN CỨNG & NGOẠI VI ================= -->
                <ScrollViewer x:Name="pageLaptopCheck" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Header Banner -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🔬 KIỂM TRA LAPTOP, PHẦN CỨNG &amp; NGOẠI VI TOÀN DIỆN" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Chẩn đoán độ chai pin, kiểm tra lịch sử sửa chữa/BIOS mainboard, test bàn phím trực quan offline, CPU stress 100%, màn hình điểm chết và âm thanh đa tần số." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>                        </Border>

                        <!-- Row 1: Battery & Repair Audit -->
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <!-- Battery Card -->
                            <Border Style="{StaticResource CardBorder}" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🔋 Kiểm Tra Pin Laptop" FontWeight="Bold" FontSize="15" Foreground="#047857" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="lblBatteryStatus" Text="Tình trạng: Đang quét..." FontSize="13" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="lblBatteryDesignCap" Text="Dung lượng thiết kế: Đang quét..." FontSize="13" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="lblBatteryFullCap" Text="Dung lượng sạc đầy: Đang quét..." FontSize="13" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="lblBatteryWear" Text="Độ chai pin: Đang quét..." FontWeight="Bold" FontSize="13.5" Margin="0,2,0,8"/>
                                    <WrapPanel>
                                        <Button x:Name="btnRefreshBattery" Content="🔄 Đo Lại Pin" Background="#047857" Style="{StaticResource ActionBtn}"/>
                                        <Button x:Name="btnExportBatteryHtml" Content="📊 Xuất Báo Cáo HTML" Background="#B45309" Style="{StaticResource ActionBtn}"/>
                                    </WrapPanel>
                                </StackPanel>                            </Border>

                            <!-- Hardware Tampering / Repair Audit Card -->
                            <Border Style="{StaticResource CardBorder}" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🔍 Kiểm Tra Laptop Đã Qua Sửa Chữa? (Audit Phần Cứng)" FontWeight="Bold" FontSize="15" Foreground="#B45309" Margin="0,0,0,6"/>
                                    <TextBlock Text="Phân tích số Serial BIOS, Bo mạch chủ, ngày xuất xưởng để phát hiện máy nạp lại BIOS trắng hoặc thay linh kiện:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button x:Name="btnRunRepairAudit" Content="🔍 Quét Serial &amp; BIOS" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="180" Padding="14,0,14,0"/>
                                    </WrapPanel>
                                </StackPanel>                            </Border>
                        </UniformGrid>

                        <!-- Row 2: Keyboard, CPU Stress & Network -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⌨️ KIỂM TRA BÀN PHÍM, HIỆU NĂNG CPU &amp; KẾT NỐI MẠNG" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="btnTestKeyboardVisual" Content="⌨️ Test Phím Trực Quan (Offline)" Background="#047857" Style="{StaticResource ActionBtn}" MinWidth="250" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestCpuStress" Content="🔥 Stress Test 100% CPU &amp; Quạt (15s)" Background="#BE123C" Style="{StaticResource ActionBtn}" MinWidth="260" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestNetworkPing" Content="🌐 Kiểm Tra Ping Mạng (Wi-Fi/LAN)" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="240" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestKeyboard" Content="🌐 Key-Test Online (Trình duyệt)" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="230" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestMic" Content="🎙️ Test Microphone" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="170" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestCam" Content="📷 Test Camera / Webcam" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="190" Padding="14,0,14,0"/>
                                </WrapPanel>
                            </StackPanel>                        </Border>

                        <!-- Row 3: Audio Stereo & Dead Pixel Screen -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🔊 TEST ÂM THANH ĐA TẦN SỐ &amp; ĐIỂM CHẾT MÀN HÌNH" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="btnTestDeadPixel" Content="📺 Test Màn Hình Full Màu (Dead Pixel)" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="260" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestAudioLeft" Content="🔊 Loa Trái (Left 1000Hz)" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="190" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestAudioRight" Content="🔊 Loa Phải (Right 1000Hz)" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="190" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestSpeakerStereo" Content="🎵 Test Chuông Stereo Hai Loa" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="220" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestAudioBass" Content="🎵 Test Âm Trầm (Bass 120-200Hz)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="230" Padding="14,0,14,0"/>
                                    <Button x:Name="btnTestAudioTreble" Content="🎵 Test Âm Cao (Treble 2500-4500Hz)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="240" Padding="14,0,14,0"/>
                                </WrapPanel>
                            </StackPanel>                        </Border>

                        <!-- Row 4: Diagnostic Log Output -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="📄 NHẬT KÝ KIỂM TRA &amp; CHẨN ĐOÁN THIẾT BỊ" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtRepairAuditLog" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" TextWrapping="Wrap" IsReadOnly="True" FontSize="13" Height="170" Text="Sẵn sàng kiểm tra. Nhấn các nút chức năng ở trên để chẩn đoán thiết bị..."/>
                            </StackPanel>                        </Border>
                    </StackPanel>                </ScrollViewer>

                <!-- ================= PAGE 10: TỐI ƯU & DỌN DẸP (TWEAKS PRO UNIFIED) ================= -->
                <ScrollViewer x:Name="pageCleaner" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,16">
                        <!-- Card 1: 1-Click Thao Tác Nhanh Tối Ưu & Dọn Rác -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚡ 1-CLICK THAO TÁC NHANH - TỐI ƯU &amp; GIẢI PHÓNG HỆ THỐNG" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="btnDeepClean" Content="🧹 Dọn Dẹp File Rác &amp; Temp" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="190" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnCleanWinUpdate" Content="📦 Dọn WinSxS &amp; Update Cache" Background="#047857" Style="{StaticResource ActionBtn}" MinWidth="200" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnFlushDnsPrefetch" Content="🌐 Xóa Prefetch &amp; Flush DNS" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="190" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnCompactOS" Content="🗜️ Nén Compact OS (Tiết kiệm 3-6GB)" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="220" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnOptimizeRAM" Content="⚡ Tối Ưu Bộ Nhớ RAM" Background="#2563EB" Style="{StaticResource ActionBtn}" MinWidth="170" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnOptimizeVisualEffects" Content="🚀 Tối Ưu Đồ Họa Siêu Mượt" Background="#047857" Style="{StaticResource ActionBtn}" MinWidth="190" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnOptimizeServices" Content="🛑 Tắt Dịch Vụ Ngầm Rác" Background="#BE123C" Style="{StaticResource ActionBtn}" MinWidth="180" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnFastStartupToggle" Content="⏱️ Bật/Tắt Khởi Động Nhanh" Background="#B45309" Style="{StaticResource ActionBtn}" MinWidth="190" Height="32" Margin="0,0,8,6"/>
                                    <Button x:Name="btnRepairSystemFiles" Content="🛡️ Quét Sửa File Win (SFC/DISM)" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="210" Height="32" Margin="0,0,8,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Khuyến Nghị Chọn Sẵn (Matching WinUtil Spec) -->
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Khuyến Nghị Chọn Sẵn (Recommended Selections):" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <UniformGrid Grid.Row="1" Columns="6" Margin="0,2,0,0">
                                    <Button x:Name="btnPresetStandard" Content="Chuẩn (Standard)" Background="#2563EB" Style="{StaticResource ActionBtn}" Height="30" Margin="2,0,2,0"/>
                                    <Button x:Name="btnPresetMinimal" Content="Tối Giản (Minimal)" Background="#334155" Style="{StaticResource ActionBtn}" Height="30" Margin="2,0,2,0"/>
                                    <Button x:Name="btnPresetAdvanced" Content="Nâng Cao (Advanced)" Background="#D97706" Style="{StaticResource ActionBtn}" Height="30" Margin="2,0,2,0"/>
                                    <Button x:Name="btnPresetClear" Content="Bỏ Chọn (Clear)" Background="#64748B" Style="{StaticResource ActionBtn}" Height="30" Margin="2,0,2,0"/>
                                    <Button x:Name="btnGetInstalledTweaks" Content="Lấy Tweak Đang Dùng" Background="#059669" Style="{StaticResource ActionBtn}" Height="30" Margin="2,0,2,0"/>
                                    <Button x:Name="btnAppXRemoval" Content="Dọn App Rác (AppX)" Background="#DC2626" Style="{StaticResource ActionBtn}" Height="30" Margin="2,0,2,0"/>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Main 2-Column Tweaks Body -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Essential & Advanced Tweaks -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="14" Margin="0,0,6,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <!-- Essential Tweaks -->
                                    <TextBlock Text="Cơ Bản An Toàn (Essential Tweaks)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Margin="2,0,0,10">
                                        <CheckBox x:Name="chk_ActivityHistory" Content="Tắt Lịch Sử Hoạt Động (Activity History - Disable)" ToolTip="Tắt đồng bộ lịch sử mở tệp và ứng dụng gửi về Microsoft" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_BitLocker" Content="Tắt Mã Hóa Ổ C (BitLocker - Disable)" ToolTip="Tắt mã hóa BitLocker trên ổ đĩa hệ thống C:" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_ConsumerFeatures" Content="Chặn Tự Cài App Rác (ConsumerFeatures - Disable)" ToolTip="Ngăn Windows tự tải game rác (Candy Crush, Disney...) vào máy" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_DeliveryOptimization" Content="Tắt Tải Ngang Hàng (Delivery Optimization - Disable)" ToolTip="Ngăn máy chia sẻ bản cập nhật cho các máy khác trên Internet" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_DiskCleanup" Content="Chạy Dọn Rác Hệ Thống (Disk Cleanup - Run)" ToolTip="Chạy công cụ giải phóng dung lượng đĩa tự động" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_EndTaskRightClick" Content="Bật End Task Chuột Phải Taskbar (End Task With Right Click)" ToolTip="Cho phép bấm chuột phải vào biểu tượng ứng dụng trên Taskbar để tắt nhanh tức thì" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_AutoFolderDiscovery" Content="Tắt Tự Dò Thư Mục (Folder Discovery - Disable)" ToolTip="Tăng tốc độ mở thư mục trong File Explorer" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_Hibernation" Content="Tắt Chế Độ Ngủ Đông (Hibernation - Disable)" ToolTip="Xóa tệp hiberfil.sys thu hồi ngay 8GB - 32GB ổ đĩa C:" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_LocationTracking" Content="Tắt Định Vị Vị Trí (Location Tracking - Disable)" ToolTip="Vô hiệu hóa cảm biến định vị vị trí địa lý của Windows" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_StoreSearchRec" Content="Tắt Gợi Ý MS Store (Store Recommended Results - Disable)" ToolTip="Không hiển thị app gợi ý của Store khi gõ tìm kiếm" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_PreventDeviceApps" Content="Chặn Tải App Kèm Thiết Bị (Prevent Device Companion Apps)" ToolTip="Không tự tải app rác khi cắm chuột/bàn phím mới" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_RestorePoint" Content="Tạo Điểm Khôi Phục (Restore Point - Create)" ToolTip="Tạo Restore Point sao lưu hệ thống trước khi tinh chỉnh" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_ServicesManual" Content="Chuyển Dịch Vụ Thừa Sang Thủ Công (Services - Set to Manual)" ToolTip="Đặt các dịch vụ không thiết yếu sang chế độ Manual" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_StartMenuLayout" Content="Bật Bố Cục Start Cũ (Start Menu Previous Layout - Enable)" ToolTip="Sử dụng giao diện Start Menu gọn gàng" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_Telemetry" Content="Tắt Thu Thập Dữ Liệu (Telemetry - Disable)" ToolTip="Tắt DiagTrack và các tiến trình chẩn đoán gửi về Microsoft" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_TempFiles" Content="Dọn Tệp Tạm &amp; Cache (Temporary Files - Remove)" ToolTip="Xóa toàn bộ Temp, Prefetch và tệp rác hệ thống" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_Widgets" Content="Gỡ Bỏ Widgets Tin Tức (Widgets - Remove)" ToolTip="Loại bỏ bảng tin tức và widget ngốn RAM trên Taskbar" Margin="0,2,0,2"/>
                                    </StackPanel>
                                    <!-- Advanced Tweaks -->
                                    <TextBlock Text="Nâng Cao - CẨN THẬN (Advanced Tweaks - CAUTION)" FontWeight="Bold" FontSize="15" Foreground="#DC2626" Margin="0,6,0,6"/>
                                    <StackPanel Margin="2,0,0,10">
                                        <CheckBox x:Name="chk_BackgroundApps" Content="Tắt App Chạy Ngầm (Background Apps - Disable)" ToolTip="Tiết kiệm tối đa pin và tài nguyên CPU/RAM" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_ReservedStorage" Content="Tắt Bộ Nhớ Dự Phòng (Disable Reserved Storage)" ToolTip="Thu hồi ~7GB dung lượng ổ C bị Windows giữ riêng" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_IPv6PreferIPv4" Content="Ưu Tiên IPv4 Hơn IPv6 (IPv6 - Set IPv4 as Preferred)" ToolTip="Khắc phục triệt để nghẽn mạng do mạng IPv6 chập chờn" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_ClassicContextMenu" Content="Menu Chuột Phải Win 10 (Right-Click Menu Previous Layout)" ToolTip="Mở ngay menu chuột phải đầy đủ mà không cần bấm 'Show more options'" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_VisualEffects" Content="Tối Ưu Hiệu Năng Tối Đa (Visual Effects - Best Performance)" ToolTip="Tắt hiệu ứng chuyển cảnh giúp máy mượt mà tức thì" Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chk_GameMode" Content="Tối Ưu Chơi Game (Game Mode &amp; Tắt Game Bar DVR)" ToolTip="Tắt Xbox Game Bar ghi ngầm giúp tăng FPS game" Margin="0,2,0,2"/>
                                    </StackPanel>
                                    <!-- DNS Configuration Dropdown -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="6" Padding="10,8,10,8" Margin="0,4,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock Text="DNS - Máy chủ phân giải:" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="cmbDnsProvider" Height="28" Width="170" HorizontalAlignment="Right">
                                                <ComboBoxItem Content="Mặc định (Default DHCP)" IsSelected="True"/>
                                                <ComboBoxItem Content="Cloudflare (1.1.1.1)"/>
                                                <ComboBoxItem Content="Google (8.8.8.8)"/>
                                                <ComboBoxItem Content="Quad9 (9.9.9.9)"/>
                                                <ComboBoxItem Content="AdGuard (94.140.14.14)"/>
                                            </ComboBox>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT COLUMN: Customize Preferences (Toggles) & Performance Plans -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="14" Margin="6,0,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Tùy Chỉnh Cá Nhân (Customize Preferences)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
