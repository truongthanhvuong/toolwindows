                            </StackPanel>                        </StackPanel>                        <Button x:Name="btnModalDriverDoctorClose" Grid.Column="1" Content="✕" Width="32" Height="32" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                    </Grid>

                    <!-- Stats Cards Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Devices -->
                        <Border Grid.Column="0" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG THIẾT BỊ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="lblDriverDoctorTotal" Text="216" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                                <TextBlock Text="Đã quét bus PnP" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>                        </Border>

                        <!-- Missing/Error Devices -->
                        <Border Grid.Column="2" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DRIVER THIẾU / LỖI" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="lblDriverDoctorIssues" Text="0 Lỗi" FontSize="18" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                                <TextBlock Text="Chấm than vàng (!)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>                        </Border>

                        <!-- GPU Status -->
                        <Border Grid.Column="4" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DRIVER ĐỒ HỌA (GPU)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="lblDriverDoctorGpu" Text="Tối ưu [OK]" FontSize="13" FontWeight="Bold" Foreground="#047857" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Tăng tốc phần cứng 3D" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>                        </Border>

                        <!-- Machine / Vendor -->
                        <Border Grid.Column="6" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="HÃNG &amp; SERVICE TAG" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="lblDriverDoctorMachine" Text="VMware / PC" FontSize="13" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Tự dò cổng chính hãng" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>                        </Border>
                    </Grid>

                    <!-- Issue List and Details -->
                    <Border Grid.Row="2" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" MinHeight="160" MaxHeight="220" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtDriverDoctorDetails" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True" FontSize="12.5" Text="Đang sẵn sàng phân tích cấu trúc Driver máy tính..."/>
                        </ScrollViewer>
                    </Border>

                    <!-- Integrated Driver Installers (1-Click Actions) -->
                    <Border Grid.Row="3" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ BỘ CÔNG CỤ CÀI ĐẶT DRIVER THIẾU TÍCH HỢP (1-CLICK):" FontWeight="Bold" FontSize="12" Foreground="#047857" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button x:Name="btnDriverAutoWinUpdate" Content="⚡ Tự Động Cài Qua Windows Update" Background="#047857" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Padding="12,0,12,0"/>
                                <Button x:Name="btnDriverSDIO" Content="🚀 Snappy Driver Installer (SDIO)" Background="#2563EB" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Padding="12,0,12,0"/>
                                <Button x:Name="btnDriver3DPChip" Content="🌐 3DP Chip (CPU/Main/GPU/Sound)" Background="#D97706" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Padding="12,0,12,0"/>
                                <Button x:Name="btnDriver3DPNet" Content="📶 3DP Net (Driver Mạng LAN/Wi-Fi)" Background="#0284C7" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Padding="12,0,12,0"/>
                                <Button x:Name="btnDriverOEMSupport" Content="🏢 Driver Chính Hãng" Background="#475569" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Padding="12,0,12,0"/>
                                <Button x:Name="btnDriverOpenDevMgmt" Content="🛠 Device Manager" Background="#334155" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Padding="12,0,12,0"/>
                            </WrapPanel>
                        </StackPanel>                    </Border>

                    <!-- Modal Footer & Progress Bar -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblDriverDoctorStatus" Text="• Sẵn sàng chẩn đoán và cài đặt driver." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ProgressBar x:Name="prgDriverDoctor" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#047857" Background="#E2E8F0" BorderThickness="0" Margin="0,4,0,0"/>
                        </StackPanel>                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnDriverDoctorRescan" Content="🔄 Quét Lại" Background="#475569" Style="{StaticResource ActionBtn}" Width="100" Margin="0,0,8,0"/>
                            <Button x:Name="btnModalDriverDoctorDone" Content="Đóng" Background="#64748B" Style="{StaticResource ActionBtn}" Width="80"/>
                        </StackPanel>                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
