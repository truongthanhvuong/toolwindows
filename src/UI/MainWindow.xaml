                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Local Installer Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="📁 Cài Đặt File Cục Bộ (.exe / .msi) Chế Độ Tự Động Silent" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
