                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnModalLoginCancel" Content="Đóng" Height="34" Background="#64748B" Style="{StaticResource ActionBtn}"/>
                        <Button x:Name="btnModalLoginSubmit" IsDefault="True" Grid.Column="2" Content="Đăng Nhập" Height="34" Background="#B45309" Style="{StaticResource ActionBtn}"/>
                    </Grid>
