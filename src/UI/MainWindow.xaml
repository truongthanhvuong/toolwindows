                                <Grid Margin="0,3,0,6">
                                    <TextBlock Text="Hãng OEM" VerticalAlignment="Center" Width="130"/>
                                    <TextBox x:Name="txtCustomManufacturer" Margin="135,0,0,0" Height="30" Text="Ví dụ: VUONGTT Technology"/>
