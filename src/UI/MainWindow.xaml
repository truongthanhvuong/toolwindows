                    <!-- Normal Password Field (Ô nhập duy nhất) -->
                    <StackPanel x:Name="pnlAdminNormalLogin">
                        <TextBlock Text="Mật khẩu Quản Trị Viên (Admin):" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="pwdAdminLogin" Height="36" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Change Password Fields (Đã chặn vĩnh viễn khỏi màn hình đăng nhập) -->
                    <StackPanel x:Name="pnlAdminFirstChangePass" Visibility="Collapsed" Height="0" Margin="0">
                        <PasswordBox x:Name="pwdAdminNewPass" Visibility="Collapsed"/>
                        <PasswordBox x:Name="pwdAdminConfirmPass" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock x:Name="lblAdminLoginError" Text="" Foreground="#BE123C" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center" Visibility="Collapsed"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnModalLoginCancel" Content="Đóng" Height="34" Background="#64748B" Style="{StaticResource ActionBtn}"/>
                        <Button x:Name="btnModalLoginSubmit" IsDefault="True" Grid.Column="2" Content="Đăng Nhập" Height="34" Background="#B45309" Style="{StaticResource ActionBtn}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL: KÍCH HOẠT LICENSE PRO ================= -->
        <Grid x:Name="modalActivatePro" Grid.ColumnSpan="2" Background="#90000000" Visibility="Collapsed">
            <Border Width="500" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border Width="38" Height="38" CornerRadius="8" Background="#D97706" Margin="0,0,10,0">
                            <TextBlock Text="⭐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Kích Hoạt Bản Quyền PRO" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="lblActivateNotice" Text="Nhập License Key để mở khóa toàn bộ tính năng cao cấp cho máy tính này." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!-- Machine HWID Display -->
                    <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8,10,8" Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Mã phần cứng (HWID):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblCurrentHWID" Text="HWID-XXXX-XXXX-XXXX-XXXX" FontWeight="Bold" FontSize="12" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Mã License Key:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtModalLicenseKey" Height="36" FontSize="14" FontWeight="Bold" TextAlignment="Center" CharacterCasing="Upper" VerticalContentAlignment="Center" Margin="0,0,0,6" Text=""/>
                    
                    <TextBlock Text="💡 Mỗi License Key chỉ kích hoạt được trên 1 máy tính duy nhất." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock x:Name="lblActivateError" Text="" Foreground="#BE123C" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center" Visibility="Collapsed"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnModalActivateCancel" Content="Đóng" Height="34" Background="#64748B" Style="{StaticResource ActionBtn}"/>
                        <Button x:Name="btnModalActivateSubmit" IsDefault="True" Grid.Column="2" Content="🚀 Kích Hoạt Ngay" Height="34" Background="#047857" Style="{StaticResource ActionBtn}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
