                                    <Button x:Name="btnUninstallStandard" Content="🗑️ Gỡ Cài Đặt Tiêu Chuẩn" Background="#B45309" Style="{StaticResource ActionBtn}" Padding="14,0,14,0" ToolTip="Thực thi lệnh gỡ cài đặt gốc của nhà sản xuất cho các mục đã chọn"/>
                                    <Button x:Name="btnSelectAllUninstApps" Content="☑️ Chọn Hết" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="115" Padding="10,0,10,0" Margin="8,0,0,0" ToolTip="Tick chọn tất cả các phần mềm đang hiển thị"/>
                                    <Button x:Name="btnDeselectAllUninstApps" Content="⬜ Bỏ Chọn" Background="#64748B" Style="{StaticResource ActionBtn}" MinWidth="110" Padding="10,0,10,0" Margin="6,0,0,0" ToolTip="Bỏ tick chọn toàn bộ phần mềm"/>
                                </StackPanel>                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnOpenAppFolder" Content="📁 Mở Thư Mục" Background="#334155" Style="{StaticResource ActionBtn}" MinWidth="135" Padding="12,0,12,0"/>
                                    <Button x:Name="btnOpenAppRegistry" Content="🔑 Mở Registry" Background="#475569" Style="{StaticResource ActionBtn}" MinWidth="135" Padding="12,0,12,0" Margin="8,0,0,0"/>
                                </StackPanel>                            </Grid>
                        </Border>

                        <!-- Execution Log Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="📄 Nhật Ký Gỡ Cài Đặt &amp; Quét Rác Chi Tiết" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
