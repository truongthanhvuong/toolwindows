                                    <Button x:Name="btnBrowseInstaller" Grid.Column="1" Content="📂 Chọn File..." Background="#475569" Style="{StaticResource ActionBtn}" Width="110" Margin="8,0,0,0"/>
                                    <Button x:Name="btnRunSilentInstall" Grid.Column="2" Content="⚡ Cài Đặt Silent" Background="#047857" Style="{StaticResource ActionBtn}" Width="130" Margin="8,0,0,0"/>
                                </Grid>
