                                    <GridView>
                                        <GridViewColumn Width="46">
                                            <GridViewColumn.Header>
                                                <CheckBox x:Name="chkSelectAllUninstApps" ToolTip="Chọn / Bỏ chọn tất cả phần mềm" VerticalAlignment="Center" HorizontalAlignment="Center"/>
