                                    <TextBlock Text="Chủ sở hữu" VerticalAlignment="Center" Width="130"/>
                                    <TextBox x:Name="txtCustomOwner" Margin="135,0,0,0" Height="30" Text="VUONGTT"/>
                                </Grid>
                                <Grid Margin="0,3,0,12">
                                    <TextBlock Text="Tổ chức" VerticalAlignment="Center" Width="130"/>
                                    <TextBox x:Name="txtCustomOrg" Margin="135,0,0,0" Height="30" Text="Không bắt buộc"/>
                                </Grid>

                                <!-- OEM (System Properties) -->
