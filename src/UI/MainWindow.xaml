                                            <CheckBox x:Name="chk_FixHighPerfGpu" Content="🎮 Ép Chạy GPU Rời (High Performance)" Margin="0,3,4,3" ToolTip="Ép toàn bộ ứng dụng đồ họa kỹ thuật (AutoCAD, SketchUp, 3ds Max...) chạy card rời NVIDIA/AMD thay vì card Onboard"/>
                                        </UniformGrid>
                                        <Button x:Name="btnRunSelectedFixes" Content="🚀 Chạy Sửa Lỗi Đã Chọn (Run Selected Fixes)" Background="#BE123C" Style="{StaticResource ActionBtn}" Height="36" FontWeight="Bold" FontSize="13.5"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- RIGHT COLUMN: Legacy Windows Panels & Remote Access -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
